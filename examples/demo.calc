# A calc scratchpad is a script you can read top to bottom.

# The four operators, and grouping
1 + 2
7 - 2 * 3
(1 + 2) * 3

# Powers are right associative, so this is 2^9
2 ^ 3 ^ 2

# A negative exponent needs no parentheses
2 ^ -1

# Unary minus binds looser than the power, as in mathematics: -(2^2)
-2 ^ 2

# Functions
sqrt(16)
pow(2, 10)
sqrt(pow(3, 2))

# The example from the brief
sqrt(16) + pow(2, 10)

# Name a value and reuse it below. A definition whose value you typed out
# shows nothing extra, because the number is already on the line.
subtotal = 128.40
tip = subtotal * 0.2

subtotal + tip

# A name with no lowercase letters is a constant: defining it twice is an
# error. Uncomment the second line to see it reported.
RATE = 0.0825
# RATE = 0.09
subtotal * RATE

# PI, E and TAU are built in, and protected by the same rule.
PI
TAU
radius = 3
PI * radius ^ 2

# Names resolve top to bottom, so this reads as an increment.
count = 1
count = count + 1
count = count + 1
count = count + 1
count = count + 1

# Name a computation with define. The body is the rest of the line after
# the colon, and the parameters are yours to name.
define double(x): x * 2
double(21)

# A { } body is the same thing written across rows. Its value is the last
# statement, so `return` is optional.
define hyp(a, b) {
  squares = a^2 + b^2
  return sqrt(squares)
}
hyp(3, 4)

# A body reads the names around it where it is called, so this one uses the
# RATE defined above.
define with_tax(amount): amount * (1 + RATE)
with_tax(subtotal)

# Put the cursor on either line below and type :plot to see its shape. The
# chart stays as you edit, so change an exponent and watch the curve move.
# :noplot closes it, and :plot bell -3..3 zooms in on the part worth seeing.
define bell(x): E ^ -(x ^ 2)
define ripple(x): x - x ^ 3 / 3

# sum adds a function across a range, both ends included. The third slot takes
# the function itself, so square goes in without its parentheses.
define square(x): x ^ 2
sum(3, 6, square)

# A function of two parameters needs one sum per parameter, nested like sigma
# notation. The outer sum drives x, the inner one y, so every pair is visited.
define pair(x, y): x + y
sum(1, 5, sum(1, 3, pair))

# Factorial is written after the number and binds tighter than anything else,
# so the second line is 2^6. All 171 factorials a double can hold are a table
# built at compile time, which is why 170! answers as fast as 4!.
4!
2 ^ 3!
170!
sum(1, 5, fact)

# Infinity is a value you can hold, in two spellings. Dividing by zero reaches
# it, but a finite sum that overflows is still reported: infinity is something
# you ask for, not something you fall into.
inf
1 / 0
-1 / 0
1 / inf
2 ^ inf
2 ^ 100000

# Try :set infinity=projective, where the two ends of the line are one point.
# Then -1 / 0 is plain inf, and inf + inf no longer has an answer.
inf + inf

# These lines show why they failed, beside them. Move onto one and its
# reason hides, so editing it is not a running commentary.
1 +
0 / 0
inf - inf
sqrt(-1)
undefined_name * 2
x1 = 5


