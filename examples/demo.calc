# A calc scratchpad is a script you can read top to bottom.

# The four operators, and grouping
1 + 2
7 - 2 * 3
(1 + 2) * 3

# Powers are right associative, so this is 2^9
2 ^ 3 ^ 2

# A negative exponent needs no parentheses
2 ^ -1

# Unary minus binds looser than the power, as in mathematics: -(2^2)
-2 ^ 2

# Functions
sqrt(16)
pow(2, 10)
sqrt(pow(3, 2))

# The example from the brief
sqrt(16) + pow(2, 10)

# Name a value and reuse it below. A definition whose value you typed out
# shows nothing extra, because the number is already on the line.
subtotal = 128.40
tip = subtotal * 0.2

subtotal + tip

# A name with no lowercase letters is a constant: defining it twice is an
# error. Uncomment the second line to see it reported.
RATE = 0.0825
# RATE = 0.09
subtotal * RATE

# PI, E and TAU are built in, and protected by the same rule.
PI
TAU
radius = 3
PI * radius ^ 2

# Names resolve top to bottom, so this reads as an increment.
count = 1
count = count + 1
count = count + 1
count = count + 1
count = count + 1

# Name a computation with define. The body is the rest of the line after
# the colon, and the parameters are yours to name.
define double(x): x * 2
double(21)

# A { } body is the same thing written across rows. Its value is the last
# statement, so `return` is optional.
define hyp(a, b) {
  squares = a^2 + b^2
  return sqrt(squares)
}
hyp(3, 4)

# A body reads the names around it where it is called, so this one uses the
# RATE defined above.
define with_tax(amount): amount * (1 + RATE)
with_tax(subtotal)

# These lines show why they failed, beside them. Move onto one and its
# reason hides, so editing it is not a running commentary.
1 +
1 / 0
sqrt(-1)
undefined_name * 2
x1 = 5


